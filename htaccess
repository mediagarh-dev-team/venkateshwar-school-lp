RewriteEngine On

# 1) /page.html ko /page pe redirect karo (purane links bhi clean ho jayenge)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2) /index ko / pe bhejo
RewriteRule ^index$ / [R=301,L]

# 3) /page ko andar se page.html serve karo
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]